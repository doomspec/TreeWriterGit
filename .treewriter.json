{
  "aiProviders": [
    {
      "name": "Claude Code",
      "command": "claude",
      "args": [
        "-p",
        "{prompt}"
      ],
      "writesFiles": true
    },
    {
      "name": "Aider",
      "command": "aider",
      "args": [
        "--message",
        "{prompt}",
        "{files}"
      ],
      "writesFiles": true
    },
    {
      "name": "Codex",
      "command": "codex",
      "args": [
        "{prompt}"
      ],
      "writesFiles": true
    },
    {
      "name": "Gemini",
      "command": "gemini",
      "args": [
        "-p",
        "{prompt}",
        "--approval-mode",
        "auto_edit"
      ],
      "writesFiles": true
    }
  ],
  "defaultProvider": "Gemini",
  "gitSync": {
    "autoSync": false
  },
  "export": {
    "autoExport": true
  }
}
