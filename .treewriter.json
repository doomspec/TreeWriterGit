{
  "aiProviders": [
    {
      "name": "Claude Code",
      "command": "claude",
      "args": [
        "-p",
        "{prompt}"
      ],
      "writesFiles": true
    },
    {
      "name": "Aider",
      "command": "aider",
      "args": [
        "--message",
        "{prompt}",
        "{files}"
      ],
      "writesFiles": true
    },
    {
      "name": "Codex",
      "command": "codex",
      "args": [
        "{prompt}"
      ],
      "writesFiles": true
    },
    {
      "name": "Gemini",
      "command": "gemini",
      "args": [
        "-p",
        "{prompt}",
        "--approval-mode",
        "auto_edit"
      ],
      "writesFiles": true
    }
  ],
  "defaultProvider": "Gemini",
  "gitSync": {
    "autoSync": false
  },
  "export": {
    "autoExport": true
  },
  "dispatchSkillsEnabled": [
    "treewriter-context-cli.md",
    "treewriter-structure-and-assets.md",
    "scientific-writing-framework-skill.md",
    "skill-scientific-writing.md",
    "writing-deslop-basics.md",
    "technology-paper-skill.md",
    "cellpose-paper-pattern-skill.md"
  ],
  "zoteroLocal": {
    "enabled": false,
    "baseUrl": "http://127.0.0.1:23119/api"
  }
}
