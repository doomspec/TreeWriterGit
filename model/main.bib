  issn = {2095-3941},
  journal = {Cancer Biology & Medicine},
  keywords = {CTLA4, Combination drug therapy, PD-1, PD-L1, biomarkers, clinical trials, immunotherapy, oncology},
  language = {en},
  month = {jun},
  note = {Number: 2},
  number = {2},
  pages = {171--193},
  shorttitle = {Immuno-oncology combinations},
  title = {Immuno-oncology combinations: raising the tail of the survival curve},
