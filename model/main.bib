  language = {en},
  number = {4},
  pages = {267--272},
  title = {Human tissue levels and plasma pharmacokinetics of temoporfin ({Foscan}®, {mTHPC})},
  url = {http://link.springer.com/article/10.1007/BF02134918},
  urldate = {2016-09-07},
  volume = {11},
