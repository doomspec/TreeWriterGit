@article{fingar_vascular_2000,
  abstract = {Microvascular damage that results in blood flow stasis is a frequent consequence of photodynamic therapy. The magnitude of this response is dependent on the type of photosensitizer employed for treatment, the amount of drug and light used in therapy and the time period between drug injection and treatment. This review highlights the mechanisms that lead to blood flow stasis in tumor and normal tissues and discusses methods to increase the selectivity of vascular response.},
  author = {Fingar, V. H. and Taber, S. W. and Haydon, P. S. and Harrison, L. T. and Kempf, S. J. and Wieman, T. J.},
  issn = {0258-851X},
