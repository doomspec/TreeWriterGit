  keywords = {Animals, Chemistry, Pharmaceutical, Cyclodextrins, Drug Delivery Systems, Drug Design, Evaluation Studies as Topic, Humans, Intestinal Absorption, Polyamines, Temperature, solubility},
  language = {eng},
  month = {aug},
  number = {8},
