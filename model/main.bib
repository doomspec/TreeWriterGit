  issn = {0022-3549},
  journal = {Journal of Pharmaceutical Sciences},
  keywords = {Chemistry, Physical, Cholesterol, Cyclodextrins, Erythrocyte Membrane, Humans, In Vitro Techniques, Lipids, Physicochemical Phenomena, alpha-Cyclodextrins, beta-Cyclodextrins, gamma-Cyclodextrins, solubility},
