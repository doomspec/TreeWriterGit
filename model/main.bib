  shorttitle = {The role of liposomes in drug delivery and diagnostic imaging},
  title = {The role of liposomes in drug delivery and diagnostic imaging: a review},
  url = {https://doi.org/10.1111/j.1740-8261.2000.tb01462.x},
  urldate = {2022-10-06},
