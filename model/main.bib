  pages = {1078--1094},
  publisher = {Nature Publishing Group},
  title = {Lipid nanoparticles for {mRNA} delivery},
  url = {https://www.nature.com/articles/s41578-021-00358-0},
  urldate = {2022-09-28},
  volume = {6},
  year = {2021},
}

