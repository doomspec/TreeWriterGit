  journal = {Journal of inclusion phenomena and macrocyclic chemistry},
  keywords = {Crystallography, Cyclodextrin, Food Science, Organic Chemistry, cyclodextrin, driving forces, enthalpy-entropy compensation, inclusion complexation, mechanism},
