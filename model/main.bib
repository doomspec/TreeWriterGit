@article{nguyen_ground_2001,
  abstract = {Density functional theory(DFT)electronic structure calculations were carried out to predict the structures and ground-state spectra for zinc complexes of porphyrin (ZnP), tetraazaporphyrin (ZnTAP), tetrabenzoporphyrin (ZnTBP), and phthalocyanine (ZnPc). All four porphyrins are found to have stable D 4h structures.Structurally, meso-tetraaza substitutions significantly reduce the central hole in ZnTAP and ZnPc compared to ZnP. The excitation energies and oscillator strengths, computed by time-dependent DFT, provide a good account of the observed spectra of all four compounds. The TDDFT spectrum of ZnPc has a number of bands in the Soret region, in agreement with the experimental spectra that have been determined through spectral deconvolution. The low energy n→π * transition (Q ′ ) reported for ZnPc, however, was not found in the computed spectrum. The effects of meso-tetraaza substitutions and tetrabenzo annulations on the spectrum of ZnP are discussed.},
  author = {Nguyen, Kiet A. and Pachter, Ruth},
  doi = {10.1063/1.1370064},
  issn = {0021-9606, 1089-7690},
  journal = {The Journal of Chemical Physics},
  keywords = {Deconvolution, Density functional theory, Macromolecules, Time dependent material structure, Zinc},
  month = {jun},
  number = {24},
  pages = {10757--10767},
  shorttitle = {Ground state electronic structures and spectra of zinc complexes of porphyrin, tetraazaporphyrin, tetrabenzoporphyrin, and phthalocyanine},
  title = {Ground state electronic structures and spectra of zinc complexes of porphyrin, tetraazaporphyrin, tetrabenzoporphyrin, and phthalocyanine: {A} density functional theory study},
  url = {http://scitation.aip.org/content/aip/journal/jcp/114/24/10.1063/1.1370064},
  urldate = {2016-09-09},
  volume = {114},
  year = {2001},
}

@article{nikolaev_autonomy_2016,
  abstract = {A robot that learns how to optimize carbon nanotube production using feedback algorithms may be a valuable partner in materials discovery. A team of scientists at the Air Force Research Laboratory and Lockheed Martin Advanced Technology Laboratories have built an Autonomous Research System (ARES), a robot guided by artificial intelligence in an iterative learning loop, that is capable of designing, executing and analyzing its own experiments orders of magnitude faster than current research methods. Teaming with human researchers, ARES learned to control the growth of carbon nanotubes by converging on a set of conditions that yielded an objective growth rate. This approach creates a rapid, high-throughput approach that is broadly applicable to other materials research problems and enables researchers to pursue more challenging experimental campaigns.},
  author = {Nikolaev, Pavel and Hooper, Daylond and Webber, Frederick and Rao, Rahul and Decker, Kevin and Krein, Michael and Poleski, Jason and Barto, Rick and Maruyama, Benji},
  copyright = {2016 The Author(s)},
  doi = {10.1038/npjcompumats.2016.31},
  issn = {2057-3960},
  journal = {npj Computational Materials},
  language = {en},
