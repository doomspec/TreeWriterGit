@article{skupin-mrugalska_current_2013,
  abstract = {The complete eradication of various targets, such as infectious agents or cancer cells, while leaving healthy host cells untouched, is still a great challenge faced in the field of medicine. Photodynamic therapy (PDT) seems to be a promising approach for anticancer treatment, as well as to combat various dermatologic and ophthalmic diseases and microbial infections. The application of liposomes as delivery systems for porphyrinoids has helped overcome many drawbacks of conventional photosensitizers and facilitated the development of novel effective photosensitizers that can be encapsulated in liposomes. The development, preclinical studies and future directions for liposomal delivery of conventional and novel photosensitizers are reviewed.},
