  doi = {10.1109/JPROC.2015.2494218},
  note = {Pages: 148-175
Publication Title: Proceedings of the IEEE
Volume: 104},
  title = {Taking the {Human} {Out} of the {Loop}: {A} {Review} of {Bayesian} {Optimization}},
  year = {2016},
