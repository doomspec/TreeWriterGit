@article{fernandez-romero_novel_2018,
  abstract = {In this study, the encapsulation of curcumin (Cur) in &ldquo;drug-in-cyclodextrin-in-liposomes (DCL)&rdquo; by following the double-loading technique (DL) was proposed, giving rise to DCL&ndash;DL. The aim was to analyze the effect of cyclodextrin (CD) on the physicochemical, stability, and drug-release properties of liposomes. After selecting didodecyldimethylammonium bromide (DDAB) as the cationic lipid, DCL&ndash;DL was formulated by adding 2-hydroxypropyl-&alpha;/&beta;/&gamma;-CD (HP&beta;CD)&ndash;Cur complexes into the aqueous phase. A competitive effect of cholesterol (Cho) for the CD cavity was found, so cholesteryl hemisuccinate (Chems) was used. The optimal composition of the DCL&ndash;DL bilayer was obtained by applying Taguchi methodology and regression analysis. Vesicles showed a lower drug encapsulation efficiency compared to conventional liposomes (CL) and CL containing HP&beta;CD in the aqueous phase. However, the presence of HP&beta;CD significantly increased vesicle deformability and Cur antioxidant activity over time. In addition, drug release profiles showed a sustained release after an initial burst effect, fitting to the Korsmeyer-Peppas kinetic model. Moreover, a direct correlation between the area under the curve (AUC) of dissolution profiles and flexibility of liposomes was obtained. It can be concluded that these &ldquo;drug-in-cyclodextrin-in-deformable&rdquo; liposomes in the presence of HP&beta;CD may be a promising carrier for increasing the entrapment efficiency and stability of Cur without compromising the integrity of the liposome bilayer.},
  author = {Fernández-Romero, Ana-María and Maestrelli, Francesca and Mura, Paola Angela and Rabasco, Antonio María and González-Rodríguez, María Luisa},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  doi = {10.3390/pharmaceutics10040256},
  journal = {Pharmaceutics},
  keywords = {antioxidant activity, curcumin, cyclodextrin, deformability, double-loading, liposome},
  language = {en},
  month = {dec},
  number = {4},
  pages = {256},
  shorttitle = {Novel {Findings} about {Double}-{Loaded} {Curcumin}-in-{HPβcyclodextrin}-in {Liposomes}},
  title = {Novel {Findings} about {Double}-{Loaded} {Curcumin}-in-{HPβcyclodextrin}-in {Liposomes}: {Effects} on the {Lipid} {Bilayer} and {Drug} {Release}},
  url = {https://www.mdpi.com/1999-4923/10/4/256},
  urldate = {2019-04-28},
  volume = {10},
  year = {2018},
}

@article{fraceto_cyclodextrin_2014,
  abstract = {This mini-review paper does not consider classical work concerning the formation of inclusion complexes between pharmaceuticals and cyclodextrins. Instead, it highlights recent reports concerning the association of these host:guest systems with other carrier systems such as liposomes and nanoparticles showing the state of art of this subject with examples of developed systems and the advantages of these strategy in order to be potential systems as drug carriers.},
