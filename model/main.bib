@article{leng_assembling_2007,
  abstract = {A stable 1:1 host-guest complex is formed between a silicon(IV) phthalocyanine conjugated axially with two permethylated beta-cyclodextrin units and a tetrasulfonated porphyrin. The complex exhibits a light-harvesting property and works as an efficient photosensitizing system, killing HT29 human colon adenocarcinoma cells with an IC50 value of 0.09 microM. [structure: see text].},
