@article{murakami_photodynamic_2012,
  abstract = {Semiconducting and metallic single-walled carbon nanotubes (s-SWNTs and m-SWNTs) were enriched by agarose gel chromatography and their photothermal and photodynamic effects were compared in H2O. Under near-infrared laser irradiation, s-SWNTs generated reactive oxygen species (ROS) more than m-SWNTs, whereas m-SWNTs produced heat more efficiently than s-SWNTs. More importantly, cancer cell killing by PDE of s-SWNTs has been disclosed for the first time.},
  author = {Murakami, Tatsuya and Nakatsuji, Hirotaka and Inada, Mami and Matoba, Yoshinori and Umeyama, Tomokazu and Tsujimoto, Masahiko and Isoda, Seiji and Hashida, Mitsuru and Imahori, Hiroshi},
