  language = {eng},
  month = {sep},
  number = {3},
  pages = {382--387},
  title = {Clinical evaluation of the cutaneous phototoxicity of 5,10,15,20-tetra(m-hydroxyphenyl)chlorin},
  volume = {68},
  year = {1998},
}

