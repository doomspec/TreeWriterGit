  pages = {1--6},
  shorttitle = {Tetra-n-propylporphycene as a tumour localizer},
  title = {Tetra-n-propylporphycene as a tumour localizer: pharmacokinetic and phototherapeutic studies in mice},
  url = {http://www.sciencedirect.com/science/article/pii/0304383589901006},
