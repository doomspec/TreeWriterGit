  abstract = {This manuscript is not intended as a comprehensive overview of the large filed of liposome technology and all its applications. However, our intent was to present current data, which are active, cutting-edge research. Because of their unique properties liposomes will continue to be investigated in drug delivery and imaging systems, and very likely will be incorporated into our discipline of veterinary medicine as the clinical applications of liposomes continue to expand.},
  author = {Matteucci, M L and Thrall, D E},
