  keywords = {Cultured cells, Mesoporphyrins, Photochemotherapy, Spectrophotometry},
  month = {feb},
  number = {3},
  pages = {261--266},
  title = {Intracellular uptake, absorption spectrum and stability of the bacteriochlorin photosensitizer 5,10,15, 20-tetrakis (m-hydroxyphenyl) bacteriochlorin ({mTHPBC}). {Comparison} with 5,10,15,20-tetrakis (m-hydroxyphenyl) chlorin ({mTHPC})},
  url = {http://www.sciencedirect.com/science/article/pii/S1011134496074210},
