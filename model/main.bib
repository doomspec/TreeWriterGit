@article{jimenez_synthesis_1994,
  abstract = {The synthesis of water-soluble ''one-face'' hindered porphyrins is reported for the first time. Two porphyrins were obtained from the sulfonation of ''basket-handle' porphyrins in concentrated sulfuric acid. These were separated by size-exclusion chromatography followed by neutralization, dialysis and lyophilization. The structural assignment of the two porphyrins was based on the H-1 NMR spectra of the free bases. Aquo-iron(III) porphyrin has been prepared and characterized. The interaction between the iron(II) porphyrin and the imidazole ligand has been investigated at pH 7 by electronic absorption spectroscopy.},
  author = {Jimenez, Hr and Momenteau, M.},
