  journal = {Photochemistry and Photobiology},
  keywords = {Acetylcholinesterase, Animals, Cell Line, Cell Survival, Erythrocyte Membrane, Humans, In Vitro Techniques, Mice, Oxygen, Photochemistry, Photolysis, Photons},
  language = {en},
  number = {2},
