@article{yakavets_matryoshka-type_2019,
  abstract = {The balance between the amount of drug delivered to tumor tissue and the homogeneity of its distribution is a challenge in the efficient delivery of photosensitizers (PSs) in photodynamic therapy (PDT) of cancer. To date, many efforts have been made using various nanomaterials to efficiently deliver temoporfin (mTHPC), one of the most potent photosensitizers. The present study aimed to develop double-loaded matryoshka-type hybrid nanoparticles encapsulating mTHPC/cyclodextrin inclusion complexes in mTHPC-loaded liposomes. This system was expected to improve the transport of mTHPC to target tissues and to strengthen its accumulation in the tumor tissue. Double-loaded hybrid nanoparticles (DL-DCL) were prepared, characterized, and tested in 2D and 3D in vitro models and in xenografted mice in vivo. Our studies indicated that DL-DCL provided deep penetration of mTHPC into the multicellular tumor spheroids via cyclodextrin nanoshuttles once the liposomes had been destabilized by serum proteins. Unexpectedly, we observed similar PDT efficiency in xenografted HT29 tumors for liposomal mTHPC formulation (Foslip&reg;) and DL-DCL.},
  author = {Yakavets, Ilya and Millard, Marie and Lamy, Laureline and Francois, Aurelie and Scheglmann, Dietrich and Wiehe, Arno and Lassalle, Henri-Pierre and Zorin, Vladimir and Bezdetnaya, Lina},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  doi = {10.3390/cancers11091366},
  journal = {Cancers},
  keywords = {cyclodextrins, drug-in-cyclodextrin-in-liposome, hybrid nanoparticles, multicellular tumor spheroids, photodynamic therapy article, temoporfin, yet reasonably common within the subject discipline},
  language = {en},
  month = {sep},
  number = {9},
  pages = {1366},
  title = {Matryoshka-{Type} {Liposomes} {Offer} the {Improved} {Delivery} of {Temoporfin} to {Tumor} {Spheroids}},
  url = {https://www.mdpi.com/2072-6694/11/9/1366},
  urldate = {2019-10-03},
  volume = {11},
  year = {2019},
}

@article{viale_cyclodextrin_2019,
  abstract = {SummaryPolymeric cyclodextrin–based nanoparticles are currently undergoing clinical trials as nanotherapeutics. Using a non-covalent approach, we decorated two cross-linked cyclodextrin polymers of different molecular weights with an RGD peptide derivative to construct a novel carrier for the targeted delivery of doxorubicin. RGD is the binding sequence for the integrin receptor family that is highly expressed in tumour tissues. The assembled host–guest systems were investigated using NMR and DLS techniques. We found that, in comparison with free doxorubicin or the binary complex doxorubicin/cyclodextrin polymer, the RGD units decorating the cyclodextrin-based nanosystems improved the selectivity and cytotoxicity of the complexed doxorubicin towards cultured human tumour cell lines. Our results suggest that the nanocarriers under study may contribute to the development of new platforms for cancer therapy.},
  author = {Viale, Maurizio and Tosto, Rita and Giglio, Valentina and Pappalardo, Giuseppe and Oliveri, Valentina and Maric, Irena and Mariggiò, Maria Addolorata and Vecchio, Graziella},
  doi = {10.1007/s10637-018-0711-9},
  issn = {1573-0646},
  journal = {Investigational New Drugs},
  keywords = {Cancer, Carbohydrates, Doxorubicin, Nanoparticles, Peptides},
  language = {en},
  month = {aug},
  number = {4},
  pages = {771--778},
  title = {Cyclodextrin polymers decorated with {RGD} peptide as delivery systems for targeted anti-cancer chemotherapy},
  url = {https://doi.org/10.1007/s10637-018-0711-9},
  urldate = {2019-10-02},
  volume = {37},
  year = {2019},
}

@article{wang_crosslinked_2017,
  abstract = {Organic micropollutants in aquatic environment such as plasticizer, pesticide and pharmaceuticals, have posed a serious threat to human health and are emerging as a great challenge to humanity. Traditional water treatment techniques fail to achieve high removal efficiency for low concentration of organic micropollutants. Here we demonstrate a water-insoluble crosslinked β-cyclodextrin (β-CD) polymer able to remove a broad-spectrum of organic micropollutants from water by rapid adsorption. A family of β-CD polymers (β-CDPs) were synthesized by nucleophilic aromatic substitution of β-CD hydroxyl groups and 4,4'-difluorodiphenylsulfone. The β-CDPs were used to adsorb various organic micropollutants in water by static or dynamic adsorption process. It was found that more than 99% micropollutants in water were removed by flowing the feed water through the column of β-CDPs. The results of static adsorption experiments indicated the adsorption process was fast and the adsorption capacity was very high (the maximal value was 113.0mg of bisphenol A per gram of β-CDP). The adsorption process was fitted well with the quasi-second-order kinetics and the Langmuir isothermal adsorption model, suggesting that it is mainly a chemical adsorption of monolayer. The water-insoluble characteristic of the β-CDPs is convenient for their separation from the treated solution after adsorption saturation for regeneration and reuse. The adsorption ability of β-CDPs was kept nearly unchanged after five filtration-regeneration cycles.},
  author = {Wang, Zhanghui and Zhang, Peibin and Hu, Fan and Zhao, Yifan and Zhu, Liping},
  doi = {10.1016/j.carbpol.2017.08.059},
  issn = {1879-1344},
  journal = {Carbohydrate Polymers},
  keywords = {2,4-dichlorophenol (PubChem CID: 8449), 2-naphthol (PubChem CID: 8663), 4,4′-difluorodiphenylsulfone (PubChem CID: 67842), Adsorption, Anhydrous potassium carbonate (PubChem CID: 11430), Bis(4-hydroxyphenyl) sulfone (PubChem CID: 6626), Bisphenol A (PubChem CID: 6623), Cellulose, Cyclodextrins, Dimethylacetamide (PubChem CID: 31374), High adsorption capacity, Organic Chemicals, Organic micropollutants, Polymers, Propranolol hydrochloride (PubChem CID: 62882), Rapid removal, Toluene (PubChem CID: 1140), Water, Water Pollutants, Chemical, Water Purification, β-Cyclodextrin polymer, β-cyclodextrin (PubChem CID: 444041)},
  language = {eng},
  month = {dec},
  pages = {224--231},
  title = {A crosslinked β-cyclodextrin polymer used for rapid removal of a broad-spectrum of organic micropollutants from water},
  volume = {177},
  year = {2017},
}

@article{gref_new_2006,
  abstract = {We show here, for the first time, that two neutral polymers may completely associate together in water to spontaneously form supramolecular nanoassemblies (nanogels) of spherical shape. The cohesion of these stable structures of about 200 nm is based upon a “lock and key” mechanism: inclusion complexes are formed between the hydrophobic alkyl chains grafted on a polysaccharide (dextran) and the molecular cavities contained in a poly-cyclodextrin polymer. Production yields reached 95%. It was established that all the alkyl chains were included within the cyclodextrins' cavities in these nanoassemblies. The multivalent character of the interactions between the two polymers ensures the stability of the nanoassemblies. Moreover, empty cyclodextrin units remained accessible for the inclusion of compounds of interest such as benzophenon or tamoxifen.},
  author = {Gref, Ruxandra and Amiel, Catherine and Molinard, Karine and Daoud-Mahammed, Samia and Sébille, Bernard and Gillet, Brigitte and Beloeil, Jean-Claude and Ringard, Catherine and Rosilio, Véronique and Poupaert, Jaques and Couvreur, Patrick},
  doi = {10.1016/j.jconrel.2005.12.025},
  issn = {0168-3659},
  journal = {Journal of Controlled Release},
  keywords = {Cyclodextrins, Drug, Inclusion complex, Nanogels, Self-assembly},
  month = {apr},
  number = {3},
  pages = {316--324},
  shorttitle = {New self-assembled nanogels based on host–guest interactions},
  title = {New self-assembled nanogels based on host–guest interactions: {Characterization} and drug loading},
  url = {http://www.sciencedirect.com/science/article/pii/S0168365906000034},
  urldate = {2019-10-02},
  volume = {111},
  year = {2006},
}

@article{anand_-cyclodextrin_2012,
  abstract = {The association of doxorubicin (DOX) and artemisinin (ART) to a β-CyD-epichlorohydrin crosslinked polymer (pβ-CyD), organized in nanoparticles of ca. 15 nm size, was investigated in neutral aqueous medium by circular dichroism (CD), UV-vis absorption and fluorescence. The stability constants and the absolute CD spectra of the drug complexes were determined by global analysis of multiwavelength data from spectroscopic titrations. The polymer pβ-CyD proved able to disrupt the DOX dimer when the latter is the predominant form of DOX in solution. The spectroscopic and photophysical properties of the complexes evidenced an alcohol-like environment for ART and an improved inherent emission ability for DOX in the nanoparticle frame.},
  author = {Anand, Resmi and Manoli, Francesco and Manet, Ilse and Daoud-Mahammed, Samia and Agostoni, Valentina and Gref, Ruxandra and Monti, Sandra},
  doi = {10.1039/c2pp25014d},
  issn = {1474-9092},
  journal = {Photochemical & Photobiological Sciences: Official Journal of the European Photochemistry Association and the European Society for Photobiology},
  keywords = {Artemisinins, Doxorubicin, Drug Carriers, Epichlorohydrin, Models, Molecular, Molecular Conformation, Nanoparticles, Particle Size, Spectrum Analysis, beta-Cyclodextrins},
  language = {eng},
  month = {aug},
  number = {8},
  pages = {1285--1292},
  shorttitle = {β-{Cyclodextrin} polymer nanoparticles as carriers for doxorubicin and artemisinin},
  title = {β-{Cyclodextrin} polymer nanoparticles as carriers for doxorubicin and artemisinin: a spectroscopic and photophysical study},
  volume = {11},
  year = {2012},
}

@article{anand_citric_2013,
  abstract = {Two citric acid crosslinked γ-cyclodextrin oligomers (pγ-CyD) with a MW of 21-33 kDa and 10-15 γ-CyD units per molecule were prepared by following green chemistry methods and were fully characterized. The non-covalent association of doxorubicin (DOX) with these macromolecules was investigated in neutral aqueous medium by means of circular dichroism (CD), UV-vis absorption and fluorescence. Global analysis of multiwavelength spectroscopic CD and fluorescence titration data, taking into account the DOX monomer-dimer equilibrium, evidenced the formation of 1 : 1 and 1 : 2 pγ-CyD unit-DOX complexes. The binding constants are 1-2 orders of magnitude higher than those obtained for γ-CyD and depend on the characteristics of the oligomer batch used. The concentration profiles of the species in solution evidence the progressive monomerization of DOX with increasing oligomer concentration. Confocal fluorescence imaging and spectral imaging showed a similar drug distribution within the MCF-7 cell line incubated with either DOX complexed to pγ-CyD or free DOX. In both cases DOX is taken up into the cell nucleus without any degradation.},
  author = {Anand, Resmi and Malanga, Milo and Manet, Ilse and Manoli, Francesco and Tuza, Kata and Aykaç, Ahmet and Ladavière, C. and Fenyvesi, Eva and Vargas-Berenguel, Antonio and Gref, Ruxandra and Monti, Sandra},
  doi = {10.1039/c3pp50169h},
  issn = {1474-9092},
