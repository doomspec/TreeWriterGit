@article{allison_oncologic_2010,
  abstract = {A myriad of naturally occurring and synthetic structures are capable of transferring the energy of light. Few, however, allow for this energy transfer to enable a type II photochemical reaction which, as currently practiced, is a fundamental component of photodynamic therapy. Even fewer of these agents, aptly termed photosensitizers, have found success in the treatment of patients. This review will focus on the oncologic photosensitizers that have come to clinical trial with outcomes published in peer reviewed journals. Based on a clinical orientation the qualities of successful photosensitizers will be examined, how current drugs fare and potential future options explored.},
  author = {Allison, Ron R. and Sibata, Claudio H.},
  doi = {10.1016/j.pdpdt.2010.02.001},
  issn = {1873-1597},
  journal = {Photodiagnosis and Photodynamic Therapy},
  keywords = {Antineoplastic Agents, Clinical Trials as Topic, Dihematoporphyrin Ether, Humans, Neoplasms, Photochemotherapy, Photosensitizing Agents},
  language = {eng},
  month = {jun},
  number = {2},
  pages = {61--75},
  shorttitle = {Oncologic photodynamic therapy photosensitizers},
  title = {Oncologic photodynamic therapy photosensitizers: a clinical review},
  volume = {7},
  year = {2010},
}

