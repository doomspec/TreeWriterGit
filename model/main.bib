@incollection{st_denis_22_2015,
  abstract = {Photodynamic therapy (PDT) involves the photonic excitation of a photosensitizer (PS) dye in the presence of ambient oxygen, in turn forming reactive oxygen species that kill undesired cells. Many conventional PS possess organic frameworks that are hydrophobic and consequently prone to aggregation in solution which both alters photophysical characteristics of the dyes and prevents desired PS localization at target cells. Though chemical modification has traditionally been used to alter PS solubility and improve drug targeting, recently the prospect of using self-assembling supramolecular liposomal and nonliposomal delivery platforms has emerged as a method for drastically improving PS drug delivery. This chapter reviews liposomal dug delivery systems as well as nonliposomal systems including polymeric micelles, block copolymers, polymersomes, fullerosomes, nanocells, nanoemulsions, and lipoplexes. As PDT emerges as a viable clinical tool for the treatment of malignant as well as other diseases, modes of improving PS localization will become increasing relevant.},
  address = {Oxford},
  author = {St Denis, T. G. and Hamblin, M. R.},
  booktitle = {Applications of {Nanoscience} in {Photomedicine}},
  isbn = {978-1-907568-67-1},
  keywords = {Micelles, block copolymers, fullerosomes, lipoplexes, nanocells, nanoemulsions, polymerosomes},
  pages = {465--485},
  publisher = {Chandos Publishing},
  title = {22 - {Supramolecular} drug delivery platforms in photodynamic therapy},
  url = {http://www.sciencedirect.com/science/article/pii/B9781907568671500228},
  urldate = {2016-09-22},
  year = {2015},
}

@incollection{karewicz_11_2014,
  abstract = {Nanocarriers are important components in novel drug formulation. They increase bioavailability, protect and stabilize more sensitive agents (e.g. proteins), minimize side effects and provide means for active targeting. In this chapter the most important properties of an ideal carrier are discussed, and two important drug delivery systems are described in more detail: stabilized liposomes and polymeric nanospheres. Typical methods to prepare these nanocarriers, the variety of the polymeric materials applied to produce them, and a selection of the more original applications of liposomes and nanoparticles are then presented. Finally, some safety issues and future trends in this field are discussed.},
  author = {Karewicz, A.},
  booktitle = {Biomaterials for {Bone} {Regeneration}},
  isbn = {978-0-85709-804-7},
  keywords = {Drug delivery system, ionic polysaccharide derivatives, nanocarrier, polymeric nanospheres, stabilized liposomes},
  pages = {351--373},
  publisher = {Woodhead Publishing},
  title = {11 - {Polymeric} and liposomal nanocarriers for controlled drug delivery},
  url = {http://www.sciencedirect.com/science/article/pii/B978085709804750011X},
  urldate = {2016-09-22},
  year = {2014},
}

@article{zanoni_3d_2016,
  abstract = {The potential of a spheroid tumor model composed of cells in different proliferative and metabolic states for the development of new anticancer strategies has been amply demonstrated. However, there is little or no information in the literature on the problems of reproducibility of data originating from experiments using 3D models. Our analyses, carried out using a novel open source software capable of performing an automatic image analysis of 3D tumor colonies, showed that a number of morphology parameters affect the response of large spheroids to treatment. In particular, we found that both spheroid volume and shape may be a source of variability. We also compared some commercially available viability assays specifically designed for 3D models. In conclusion, our data indicate the need for a pre-selection of tumor spheroids of homogeneous volume and shape to reduce data variability to a minimum before use in a cytotoxicity test. In addition, we identified and validated a cytotoxicity test capable of providing meaningful data on the damage induced in large tumor spheroids of up to diameter in 650 μm by different kinds of treatments.},
  author = {Zanoni, Michele and Piccinini, Filippo and Arienti, Chiara and Zamagni, Alice and Santi, Spartaco and Polico, Rolando and Bevilacqua, Alessandro and Tesei, Anna},
  doi = {10.1038/srep19103},
  issn = {2045-2322},
  journal = {Scientific Reports},
  language = {eng},
  month = {jan},
  pages = {19103},
  shorttitle = {{3D} tumor spheroid models for in vitro therapeutic screening},
  title = {{3D} tumor spheroid models for in vitro therapeutic screening: a systematic approach to enhance the biological relevance of data obtained},
  volume = {6},
  year = {2016},
}

@article{serrano-andres_interpretation_1998,
  abstract = {Multiconfigurational second-order perturbation (CASPT2) calculations 
have been performed on the low-lying optically allowed valence excited
states of the free base porphin molecule in order to assign the four
lowest bands of the spectrum. The low-lying triplet states have also
been characterized. A basis set of the atomic natural orbital type of
split-valence plus polarization quality for first-row atoms has been
employed. Polarization functions are important for an accurate
description of the transitions. These CASPT2 results provide a
consistent picture of the experimental spectrum. Each band of the
spectrum up to 4.5 eV is composed of a pair of states, which become
degenerate in the spectra of metal-porphyrins. Our interpretation
deviates from assignments based on other types of ab initio
calculations.},
  author = {Serrano-Andrés, Luis and Merchán, Manuela and Rubio, Mercedes and Roos, Björn O.},
  doi = {10.1016/S0009-2614(98)00934-8},
  issn = {0009-2614},
  journal = {Chemical Physics Letters},
  month = {oct},
  pages = {195--203},
  title = {Interpretation of the electronic absorption spectrum of free base porphin by using multiconfigurational second-order perturbation theory},
  url = {http://adsabs.harvard.edu/abs/1998CPL...295..195S},
  urldate = {2016-09-09},
  volume = {295},
  year = {1998},
}

@article{shkirman_interpretation_1999,
  abstract = {Low-temperature (77 K) absorption, fluorescence, and fluorescence-excitation spectra and the fluorescence polarization spectrum for N-methyl-meso-tetraphenylporphin (N-methyl-TPP) are measured. Based on the polarization spectrum the absorption spectrum in the visible region (a “generic” porphyrin spectrum) is interpreted. In particular, it is shown that the fifth absorption band (the “Longo band”) that manifests itself in some porphyrins is a Qy(0–2) band and does not belong to the individual electron transition. Emphasis is placed on the region of the Soret band. It is inferred that at least two allowed electron transitions (G →Bx and G→By) polarized mutually perpendicularly manifect themselves in this region. The interpretation of the Soret band of porphyrins [2] that attributes this band to one electron transition G→Bx is thereby rejected. This interpretation is confirmed by computer modeling of the polarization spectrum. Special features of the experimental polarization spectrum are explained by a more developed vibrational structure and, possibly, a larger half-width of the Bx band than the half-width of the By band. The contribution of the states of intramolecular charge transfer to the formation of the Soret band is discussed.},
  author = {Shkirman, S. F. and Solov’ev, K. N. and Kachura, T. F. and Arabei, S. A. and Skakovskii, E. D.},
  doi = {10.1007/BF02679221},
  issn = {0021-9037, 1573-8647},
  journal = {Journal of Applied Spectroscopy},
  language = {en},
  number = {1},
  pages = {68--75},
  title = {Interpretation of the soret band of porphyrins based on the polarization spectrum of {N}-methyltetraphenylporphin fluorescence},
  url = {http://link.springer.com/article/10.1007/BF02679221},
  urldate = {2016-09-25},
  volume = {66},
  year = {1999},
}

