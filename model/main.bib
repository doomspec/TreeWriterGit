  pages = {494--499},
  publisher = {Scientific Research Publishing},
  shorttitle = {A {New} {Biological} {Strategy} for {Drug} {Delivery}},
  title = {A {New} {Biological} {Strategy} for {Drug} {Delivery}: {Eucaryotic} {Cell}-{Derived} {Nanovesicles}},
  url = {http://www.scirp.org/Journal/Paperabs.aspx?paperid=9117},
