  journal = {Nanoscale Research Letters},
  month = {apr},
  number = {1},
  pages = {207},
  title = {The {Research} and {Applications} of {Quantum} {Dots} as {Nano}-{Carriers} for {Targeted} {Drug} {Delivery} and {Cancer} {Therapy}},
  url = {https://doi.org/10.1186/s11671-016-1394-9},
