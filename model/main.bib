  pages = {1452--1458},
  title = {{MTT} assays allow quick and reliable measurement of the response of human tumour cells to photodynamic therapy},
  url = {http://www.sciencedirect.com/science/article/pii/095980499290542A},
  urldate = {2016-09-25},
  volume = {28},
  year = {1992},
}

