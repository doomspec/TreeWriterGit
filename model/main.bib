  keywords = {Dendrimer biocompatibility and toxicity, Dendrimer biomedical applications, Dendrimer generations, Dendrimer mediated solubilisation, Dendritic box, Drug—dendrimer conjugation, Host—guest interactions, PEGylated dendrimer, dendrimer, pH responsive dendrimer},
