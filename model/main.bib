  pages = {115763},
  shorttitle = {Study of oxyresveratrol complexes with insoluble cyclodextrin based nanosponges},
  title = {Study of oxyresveratrol complexes with insoluble cyclodextrin based nanosponges: {Developing} a novel way to obtain their complexation constants and application in an anticancer study},
