  shorttitle = {Solid lipid nanoparticles ({SLN}) of tretinoin},
  title = {Solid lipid nanoparticles ({SLN}) of tretinoin: {Potential} in topical delivery},
  url = {http://www.sciencedirect.com/science/article/pii/S0378517307004760},
  urldate = {2020-02-16},
