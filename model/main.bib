  issn = {0022-3573},
  journal = {The Journal of Pharmacy and Pharmacology},
  keywords = {Acetaminophen, Calorimetry, Differential Scanning, Cyclodextrins, Kinetics, Powders, Tablets, X-Ray Diffraction, beta-Cyclodextrins, solubility},
  language = {eng},
  month = {jan},
