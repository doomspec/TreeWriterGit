@article{van_hees_application_1999,
  abstract = {PURPOSE: Piroxicam is a poorly soluble NSAID, whose solubility is enhanced when included into beta-cyclodextrin. The preparation of a piroxicam-beta-cyclodextrin inclusion compound using supercritical CO2 was investigated.
METHODS: The solubility and the stability of piroxicam in supercritical CO2 were determined. Then, the influence of the temperature, the pressure and the time of exposure on the inclusion rate was studied.
RESULTS: The solubility of piroxicam varied over a wide range depending on the temperature and pressure (from 0.006 to 1.500 mg/g of CO2). The temperature and the time of exposure had a great influence on the inclusion yield, while pressure did not and a complete inclusion was achieved by keeping a physical mixture of piroxicam and beta-cyclodextrin (1:2.5 mol/mol) for 6 hours at 150 degrees C and 15 MPa of CO2. This complex was characterized by Differential Scanning Calorimetry, differential solubility and Fourier Transform Infrared Spectrometry.
CONCLUSIONS: Supercritical carbon dioxide may prove to be a novel useful complexation method of drugs into beta-cyclodextrin.},
  author = {Van Hees, T. and Piel, G. and Evrard, B. and Otte, X. and Thunus, L. and Delattre, L.},
  issn = {0724-8741},
  journal = {Pharmaceutical Research},
  keywords = {Calorimetry, Differential Scanning, Carbon Dioxide, Cyclodextrins, Drug Compounding, Drug Stability, Excipients, Freeze Drying, Piroxicam, Pressure, Spectrophotometry, Infrared, Spectrophotometry, Ultraviolet, Temperature, Water, beta-Cyclodextrins, solubility},
  language = {eng},
  month = {dec},
  number = {12},
  pages = {1864--1870},
  title = {Application of supercritical carbon dioxide for the preparation of a piroxicam-beta-cyclodextrin inclusion compound},
  volume = {16},
  year = {1999},
}

